# Copy to .env.local for local use, or add these in Vercel > Project > Settings > Environment Variables.

# ---- AI provider ----
# Local: Ollama on this machine
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Ollama Cloud instead of local (works on Vercel): OLLAMA_URL=https://ollama.com and set OLLAMA_API_KEY
# OLLAMA_API_KEY=

# Any OpenAI-compatible API (Groq, OpenRouter, Together, OpenAI...), e.g. for Vercel:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# Let the browser choose the model (default: true locally, false on Vercel)
# ALLOW_MODEL_OVERRIDE=false

# ---- Storage ----
# Local default: JSON files in ./data-store. On Vercel add Upstash Redis (Marketplace) which sets:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Access ----
# Shared key required by the API (the browser asks for it once). Strongly recommended on Vercel.
# APP_ACCESS_KEY=
